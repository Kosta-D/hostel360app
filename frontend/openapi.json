  "components": {
    "schemas": {
      "StayRequest": {
        "type": "object",
        "description": "Pass guestId for an existing guest, or guestName (and guestCountry) to create one.",
        "properties": {
          "roomId": {
            "type": "integer",
            "format": "int64"
          },
          "guestId": {
            "type": "integer",
            "format": "int64"
          },
          "guestName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "guestCountry": {
            "type": "string",
            "maxLength": 60,
            "minLength": 0
          },
          "people": {
            "type": "integer",
            "format": "int32",
            "maximum": 2,
            "minimum": 1
          },
          "longTerm": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "enum": [
              "BOOKING",
              "DIRECT"
            ]
          },
          "checkIn": {
            "type": "string",
            "format": "date"
          },
          "checkOut": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "enum": [
              "EUR",
              "RSD"
            ]
          },
          "paymentStatus": {
            "type": "string",
            "enum": [
              "NOT_PAID",
              "PARTLY_PAID",
              "PAID"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 500,
            "minLength": 0
          }
        },
        "required": [
          "amount",
          "checkIn",
          "currency",
          "longTerm",
          "paymentStatus",
          "people",
          "roomId"
        ]
      },
      "Stay": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "room": {
            "$ref": "#/components/schemas/StayRoom"
          },
          "guest": {
            "$ref": "#/components/schemas/StayGuest"
          },
          "people": {
            "type": "integer",
            "format": "int32"
          },
          "longTerm": {
            "type": "boolean"
          },
          "source": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "BOOKING",
              "DIRECT"
            ]
          },
          "checkIn": {
            "type": "string",
            "format": "date"
          },
          "checkOut": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Exclusive end date; empty for an open-ended long-term stay"
          },
          "nights": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Short stays only"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "enum": [
              "EUR",
              "RSD"
            ]
          },
          "eurToRsd": {
            "type": "number"
          },
          "amountEur": {
            "type": "number",
            "description": "Amount converted to EUR with the saved rate"
          },
          "paymentStatus": {
            "type": "string",
            "enum": [
              "NOT_PAID",
              "PARTLY_PAID",
              "PAID"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "BOOKED",
              "CHECKED_IN",
              "CHECKED_OUT",
              "CANCELLED"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "amount",
          "amountEur",
          "checkIn",
          "currency",
          "eurToRsd",
          "guest",
          "id",
          "longTerm",
          "paymentStatus",
          "people",
          "room",
          "status"
        ]
      },
      "StayGuest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "country": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "StayRoom": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "number"
        ]
      },
      "Settings": {
        "type": "object",
        "properties": {
          "hostelName": {
            "type": "string",
            "minLength": 1
          },
          "eurToRsd": {
            "type": "number",
            "minimum": 0.0001
          }
        },
        "required": [
          "eurToRsd",
          "hostelName"
        ]
      },
      "RoomRequest": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "format": "int32",
            "maximum": 999,
            "minimum": 1
          },
          "name": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0
          },
          "floor": {
            "type": "integer",
            "format": "int32",
            "maximum": 2,
            "minimum": 1
          },
          "capacity": {
            "type": "integer",
            "format": "int32",
            "maximum": 2,
            "minimum": 1
          },
          "longTerm": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "NEEDS_CLEANING",
              "TAKEN"
            ]
          }
        },
        "required": [
          "capacity",
          "floor",
          "longTerm",
          "name",
          "number",
          "status"
        ]
      },
      "Room": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "floor": {
            "type": "integer",
            "format": "int32"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          },
          "longTerm": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "NEEDS_CLEANING",
              "TAKEN"
            ]
          }
        },
        "required": [
          "capacity",
          "floor",
          "id",
          "longTerm",
          "name",
          "number",
          "status"
        ]
      },
      "GuestRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "country": {
            "type": "string",
            "maxLength": 60,
            "minLength": 0
          },
          "note": {
            "type": "string",
            "maxLength": 500,
            "minLength": 0
          }
        },
        "required": [
          "name"
        ]
      },
      "Guest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "country": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "password",
          "username"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "expiresAt",
          "token"
        ]
      },
      "RoomStatusRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "NEEDS_CLEANING",
              "TAKEN"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
