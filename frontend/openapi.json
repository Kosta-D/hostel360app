  "components": {
    "schemas": {
      "StayRequest": {
        "type": "object",
        "description": "Pass guestId for an existing guest, or guestName (and guestCountry) to create one.",
        "properties": {
          "roomId": {
            "type": "integer",
            "format": "int64"
          },
          "guestId": {
            "type": "integer",
            "format": "int64"
          },
          "guestName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "guestCountry": {
            "type": "string",
            "maxLength": 60,
            "minLength": 0
          },
          "people": {
            "type": "integer",
            "format": "int32",
            "maximum": 2,
            "minimum": 1
          },
          "longTerm": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "enum": [
              "BOOKING",
              "DIRECT"
            ]
          },
          "checkIn": {
            "type": "string",
            "format": "date"
          },
          "checkOut": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "enum": [
              "EUR",
              "RSD"
            ]
          },
          "paymentStatus": {
            "type": "string",
            "enum": [
              "NOT_PAID",
              "PARTLY_PAID",
              "PAID"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 500,
            "minLength": 0
          }
        },
        "required": [
          "amount",
          "checkIn",
          "currency",
          "longTerm",
          "paymentStatus",
          "people",
          "roomId"
        ]
      },
      "Stay": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "room": {
            "$ref": "#/components/schemas/StayRoom"
          },
          "guest": {
            "$ref": "#/components/schemas/StayGuest"
          },
          "people": {
            "type": "integer",
            "format": "int32"
          },
          "longTerm": {
            "type": "boolean"
          },
          "source": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "BOOKING",
              "DIRECT"
            ]
          },
          "checkIn": {
            "type": "string",
            "format": "date"
          },
          "checkOut": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Exclusive end date; empty for an open-ended long-term stay"
          },
          "nights": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Short stays only"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "enum": [
              "EUR",
              "RSD"
            ]
          },
          "eurToRsd": {
